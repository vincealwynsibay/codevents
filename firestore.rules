rules_version = '2';

// Almost everything goes through the Next.js server with the Admin SDK,
// which bypasses these rules. Browsers never talk to Firestore directly...
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // ...except shared build mode: anyone can READ blocks for live updates.
    // Writes still only happen through the server (lib/actions/builds.ts).
    match /buildBlocks/{blockId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
